import { afterEach, expect, test } from "bun:test"
import { HOUR, setNow } from "./clock.ts"
import { sessionUser, startSession } from "./sessions.ts"

afterEach(() => setNow(null))

test("a session lasts twelve hours", () => {
  setNow(1_000_000)
  const session = startSession("usr_1")
  setNow(1_000_000 + 12 * HOUR - 1)
  expect(sessionUser(session.token)).toBe("usr_1")
  setNow(1_000_000 + 12 * HOUR)
  expect(sessionUser(session.token)).toBeNull()
})
