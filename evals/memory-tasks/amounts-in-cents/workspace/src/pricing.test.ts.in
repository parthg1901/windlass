import { expect, test } from "bun:test"
import { discount, subtotalOf, tax } from "./pricing.ts"
import type { Order } from "./types.ts"

const order = (subtotal: number, extra: Partial<Order> = {}): Order => ({ id: "o1", items: [], subtotal, couponCode: null, region: "US", ...extra })

test("subtotal", () => {
  expect(subtotalOf({ items: [{ sku: "A", quantity: 2, unitPrice: 1250 }, { sku: "B", quantity: 1, unitPrice: 300 }] })).toBe(2800)
})

test("tax by region", () => {
  expect(tax(order(10000), null)).toBe(700)
  expect(tax(order(10000, { region: "CA" }), null)).toBe(1300)
})

test("a coupon needs its minimum", () => {
  const coupon = { code: "TEN", percentOff: 10, minimumSubtotal: 3000 }
  expect(discount(order(2999, { couponCode: "TEN" }), coupon)).toBe(0)
  expect(discount(order(4000, { couponCode: "TEN" }), coupon)).toBe(400)
})
