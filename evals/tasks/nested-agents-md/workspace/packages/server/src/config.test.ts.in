import { expect, test } from "bun:test"
import { loadConfig } from "./config.ts"

test("defaults", () => {
  expect(loadConfig({})).toEqual({ port: 8080, host: "0.0.0.0" })
})

test("from the environment", () => {
  expect(loadConfig({ PORT: "3000", HOST: "127.0.0.1" })).toEqual({ port: 3000, host: "127.0.0.1" })
})
